{
  "name": "lgp-presupuestos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE\" -c \"blue,green\" \"node server/index.js\" \"vite --open\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "app": "electron .",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:installer": "vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.lgp.presupuestos",
    "productName": "LGP Presupuestos",
    "publish": {
      "provider": "github",
      "owner": "joaquincardozouni",
      "repo": "LGP-Presupuestos"
    },
    "directories": {
      "output": "dist_app"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "data/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
